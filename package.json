    "astro": "^7.2.1",
    "sanity": "^5.31.1",
    "styled-components": "^6.5.3",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49"
  }
