# Sanity content API - used by Astro at build time and local development.
PUBLIC_SANITY_PROJECT_ID=glbnoc37
PUBLIC_SANITY_DATASET=production

# Sanity Studio - used by `sanity dev`, `sanity build`, and `sanity deploy`.
SANITY_STUDIO_PROJECT_ID=glbnoc37
SANITY_STUDIO_DATASET=production
SANITY_STUDIO_PREVIEW_URL=https://www.prohandymansg.com

# Optional private token for reading draft/private content at build time.
# Add this to Vercel and local .env if the dataset is private.
SANITY_API_READ_TOKEN=

# Used by docs/scripts for Sanity -> Vercel rebuild automation.
SANITY_DEPLOY_WEBHOOK_URL=https://api.vercel.com/v1/integrations/deploy/prj_RfFjgvRYw1pXAqp3MbltEwQd2snr/5E8MiOXCrX
