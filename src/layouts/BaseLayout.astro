---
import '@/styles/global.css';
import Navbar from '@/components/Navbar.astro';
import Footer from '@/components/Footer.astro';
import FloatingWhatsApp from '@/components/FloatingWhatsApp.astro';
import { getSiteSettings } from '@/lib/sanity/content.js';

const {
  title = 'Pro Handyman SG | Professional Handyman Services Singapore',
  description = 'Premium handyman services in Singapore for homes, offices, shops, and properties. Explore repair, installation, maintenance, renovation, and reinstatement services.',
  canonical = 'https://www.prohandymansg.com/',
  image = 'https://images.unsplash.com/photo-1581244277943-fe4a9c777189?auto=format&fit=crop&w=1600&q=80',
  noIndex = false,
  schema = []
} = Astro.props;

const { contact } = await getSiteSettings();
const schemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'LocalBusiness',
    name: 'Pro Handyman SG',
    url: 'https://www.prohandymansg.com',
    telephone: contact.phone,
    email: contact.email,
    areaServed: { '@type': 'Country', name: 'Singapore' },
    description: 'Professional handyman services for residential, commercial, office, and property needs across Singapore.'
  },
  ...schema
];
---

<!doctype html>
<html lang="en-SG">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script is:inline>
      (() => {
        const storageKey = 'pro-handyman-sg-theme';
        const root = document.documentElement;
        const storedTheme = localStorage.getItem(storageKey);
        const theme = storedTheme === 'dark' || storedTheme === 'light' ? storedTheme : 'light';

        root.dataset.theme = theme;
        root.style.colorScheme = theme;
      })();
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    {noIndex && <meta name="robots" content="noindex,nofollow" />}
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#102027" data-theme-color />
    <slot name="head" />
    {schemas.map((item) => <script type="application/ld+json" set:html={JSON.stringify(item)} />)}
  </head>
  <body>
    <Navbar />
    <main>
      <slot />
    </main>
    <Footer />
    <FloatingWhatsApp />
    <script>
      import '@/scripts/site.js';
    </script>
  </body>
</html>
