---
import { categories, services, servicePath, subServicePath, serviceSummary } from '@/data/services.js';
import Icon from './Icon.astro';
const { compact = false, title = 'Find the right handyman service', subtitle = 'Search every main service and sub-service from the Pro Handyman SG service range.' } = Astro.props;
---

<section class={compact ? 'py-8' : 'section-padding'} data-service-search>
  <div class="container-shell">
    <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
      <div class="max-w-3xl">
        <span class="eyebrow">Service Discovery</span>
        <h2 class="section-title mt-4">{title}</h2>
        <p class="mt-4 text-lg leading-8 text-graphite/80">{subtitle}</p>
      </div>
      <label class="relative block w-full max-w-md">
        <span class="sr-only">Search services</span>
        <Icon name="Search" class="pointer-events-none absolute left-4 top-1/2 h-5 w-5 -translate-y-1/2 text-graphite/45" />
        <input data-search-input type="search" placeholder="Search door, pipe, flooring..." class="h-14 w-full rounded-full border border-ink/10 bg-white pl-12 pr-5 text-base font-semibold shadow-soft placeholder:text-graphite/45" />
      </label>
    </div>

    <div class="mt-8 flex gap-2 overflow-x-auto pb-2" aria-label="Service filters">
      {categories.map((category, index) => (
        <button class="filter-chip shrink-0 rounded-full border border-ink/10 bg-white px-4 py-2 text-sm font-extrabold text-graphite transition hover:border-brass" data-filter={category} data-active={index === 0 ? 'true' : 'false'} aria-pressed={index === 0 ? 'true' : 'false'}>{category}</button>
      ))}
    </div>

    <div class="mt-8 grid gap-4 md:grid-cols-2 xl:grid-cols-3">
      {services.map((service) => (
        <article
          class="service-card group overflow-hidden rounded-[1.5rem] border border-ink/10 bg-white shadow-soft transition duration-300 hover:-translate-y-1 hover:shadow-lift"
          data-service-card
          data-category={service.category}
          data-popular={service.popular ? 'true' : 'false'}
          data-search={`${service.name} ${service.category} ${service.subServices.map((sub) => sub.name).join(' ')}`.toLowerCase()}
        >
          <a href={servicePath(service)} class="block">
            <div class="relative aspect-[16/9] overflow-hidden bg-linen">
              <img src={service.image} alt={`${service.name} service in Singapore`} loading="lazy" class="h-full w-full object-cover transition duration-500 group-hover:scale-105" />
              <div class="absolute inset-0 bg-gradient-to-t from-ink/80 via-ink/10 to-transparent"></div>
              <div class="absolute bottom-4 left-4 flex items-center gap-2">
                <span class="grid h-11 w-11 place-items-center rounded-2xl bg-paper text-brass"><Icon name={service.icon} class="h-5 w-5" /></span>
                {service.popular && <span class="rounded-full bg-brass px-3 py-1 text-xs font-extrabold text-ink">Popular</span>}
              </div>
            </div>
            <div class="p-5">
              <div class="flex items-start justify-between gap-3">
                <h3 class="font-display text-xl font-extrabold">{service.name}</h3>
                <span class="rounded-full bg-linen px-3 py-1 text-xs font-extrabold text-brass">{service.category}</span>
              </div>
              <p class="mt-3 text-sm leading-6 text-graphite/75">{serviceSummary(service)}</p>
              {service.subServices.length > 0 && (
                <div class="mt-4 flex flex-wrap gap-2">
                  {service.subServices.slice(0, 4).map((sub) => <span class="rounded-full bg-mist px-3 py-1 text-xs font-bold text-graphite">{sub.name}</span>)}
                </div>
              )}
              <div class="mt-5 flex items-center justify-between text-sm font-extrabold text-brass">
                <span>{service.subServices.length ? `${service.subServices.length} sub-services` : 'Service details'}</span>
                <Icon name="ArrowRight" class="h-4 w-4 transition group-hover:translate-x-1" />
              </div>
            </div>
          </a>
        </article>
      ))}
    </div>

    <div data-empty-state hidden class="mt-10 rounded-[1.5rem] border border-dashed border-ink/20 bg-white p-8 text-center">
      <h3 class="font-display text-2xl font-extrabold">No matching services found</h3>
      <p class="mt-2 text-graphite/75">Try a different repair, room, fixture, or material name.</p>
    </div>
  </div>
</section>
