  href={contact.whatsappHref}
  target="_blank"
  rel="noopener noreferrer"
  class="floating-whatsapp group"
  aria-label={`Chat on WhatsApp at ${contact.phone}`}
  title={`WhatsApp ${contact.phone}`}
>
