  ArrowRight,
  Building2,
  CheckCircle2,
  ChevronDown,
  ClipboardCheck,
  Clock3,
  DoorOpen,
  Drill,
  Droplets,
  Hammer,
  HardHat,
  Home,
  Layers,
  MapPin,
  Menu,
  Moon,
  PaintRoller,
  PanelTop,
  PanelsTopLeft,
  Phone,
  Recycle,
  Refrigerator,
  Ruler,
  Search,
  ShieldCheck,
  Sparkles,
  Star,
  Sun,
  Trash2,
  Tv,
  Undo2,
  WashingMachine,
  Wind,
  Wrench,
  X,
  Zap
} from '@lucide/astro';

const icons = {
  ArrowRight,
  Building2,
  CheckCircle2,
  ChevronDown,
  ClipboardCheck,
  Clock3,
  DoorOpen,
  Drill,
  Droplets,
  Hammer,
  HardHat,
  Home,
  Layers,
  MapPin,
  Menu,
  Moon,
  PaintRoller,
  PanelTop,
  PanelsTopLeft,
  Phone,
  Recycle,
  Refrigerator,
  Ruler,
  Search,
  ShieldCheck,
  Sparkles,
  Star,
  Sun,
  Trash2,
  Tv,
  Undo2,
  WashingMachine,
  Wind,
  Wrench,
  X,
  Zap
};

const { name = 'Wrench', class: className = 'h-5 w-5', ...attrs } = Astro.props;
const Component = icons[name] || Wrench;
---

<Component class={className} {...attrs} />
