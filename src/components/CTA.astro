---
import Icon from './Icon.astro';
const { title = 'Ready to plan your repair?', text = 'Tell us what needs attention and we will help you shape the next step with a clear quote request.' } = Astro.props;
---

<section class="section-padding">
  <div class="container-shell">
    <div class="reveal overflow-hidden rounded-[2rem] bg-ink p-8 text-white shadow-lift sm:p-12 lg:p-14">
      <div class="grid gap-8 lg:grid-cols-[1.1fr_0.9fr] lg:items-center">
        <div>
          <span class="eyebrow border-white/15 bg-white/10 text-brass">Request A Quote</span>
          <h2 class="mt-5 font-display text-3xl font-extrabold leading-tight sm:text-5xl">{title}</h2>
          <p class="mt-4 max-w-2xl text-white/72">{text}</p>
        </div>
        <div class="flex flex-col gap-3 sm:flex-row lg:justify-end">
          <a href="/request-quote" class="btn-brass">Get a Free Quote <Icon name="ArrowRight" class="h-4 w-4" /></a>
          <a href="/services" class="inline-flex items-center justify-center rounded-full border border-white/20 px-5 py-3 text-sm font-extrabold text-white transition hover:bg-white/10">Explore Services</a>
        </div>
      </div>
    </div>
  </div>
</section>
