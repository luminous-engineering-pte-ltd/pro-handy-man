---
import { services, subServicePath } from '@/data/services.js';
import Icon from './Icon.astro';
import { contact } from '@/data/contact.js';
---

<header data-header class="fixed inset-x-0 top-0 z-50 px-3 py-2 transition sm:px-4 sm:py-3">
  <div class="mx-auto w-full max-w-[1216px]">
    <div class="flex h-14 items-center justify-between gap-3 rounded-full border border-ink/10 bg-white px-3 shadow-lift backdrop-blur-xl transition sm:h-16 sm:px-4 lg:px-5 [.is-scrolled_&]:h-12 sm:[.is-scrolled_&]:h-14 [.is-scrolled_&]:shadow-lift">
      <a href="/" class="flex min-w-0 items-center gap-2 sm:gap-2.5" aria-label="Pro Handyman SG home">
        <span class="grid h-9 w-9 shrink-0 place-items-center rounded-full bg-ink text-brass sm:h-10 sm:w-10"><Icon name="Wrench" class="h-4 w-4 sm:h-5 sm:w-5" /></span>
        <span class="hidden truncate font-display text-base font-extrabold tracking-tight text-ink min-[420px]:inline lg:text-lg">Pro Handyman SG</span>
      </a>

      <nav class="hidden items-center gap-3 text-sm font-extrabold xl:flex xl:gap-5">
        <a href="/" class="rounded-full px-3 py-2 text-graphite transition hover:bg-ink hover:text-white">Home</a>
        <button data-mega-button aria-expanded="false" class="inline-flex items-center gap-1 rounded-full px-3 py-2 text-graphite transition hover:bg-ink hover:text-white">
          Services <Icon name="ChevronDown" class="h-3.5 w-3.5" />
        </button>
        <a href="/about" class="rounded-full px-3 py-2 text-graphite transition hover:bg-ink hover:text-white">About</a>
        <a href="/blog" class="rounded-full px-3 py-2 text-graphite transition hover:bg-ink hover:text-white">Blog</a>
        <a href="/contact" class="rounded-full px-3 py-2 text-graphite transition hover:bg-ink hover:text-white">Contact</a>
      </nav>

      <div class="flex shrink-0 items-center gap-1.5 sm:gap-2">
        <a href={contact.phoneHref} class="inline-flex h-9 w-9 items-center justify-center rounded-full bg-ink text-white shadow-sm transition duration-200 hover:-translate-y-0.5 hover:bg-graphite active:translate-y-0 sm:h-10 sm:w-10" aria-label={`Call ${contact.phone}`} title={`Call ${contact.phone}`}>
          <Icon name="Phone" class="h-4 w-4" />
        </a>
        <button data-theme-toggle type="button" class="theme-toggle grid h-9 w-9 place-items-center rounded-full border border-ink/10 bg-white text-ink shadow-sm transition duration-200 hover:-translate-y-0.5 hover:border-brass/50 hover:bg-linen active:translate-y-0 sm:h-10 sm:w-10" aria-label="Switch to dark mode" title="Switch to dark mode">
          <Icon name="Moon" class="theme-toggle__moon h-4 w-4 sm:h-5 sm:w-5" aria-hidden="true" />
          <Icon name="Sun" class="theme-toggle__sun h-4 w-4 sm:h-5 sm:w-5" aria-hidden="true" />
        </button>
        <span class="hidden xl:block">
          <a href="/request-quote" class="inline-flex h-11 items-center justify-center gap-3 rounded-full bg-brass px-5 text-sm font-extrabold text-ink transition duration-200 hover:-translate-y-0.5 hover:brightness-105 active:translate-y-0">Get Quote <Icon name="ArrowRight" class="h-3.5 w-3.5" /></a>
        </span>
        <button data-menu-button class="grid h-9 w-9 place-items-center rounded-full border border-ink/10 bg-white text-ink sm:h-10 sm:w-10 xl:hidden" aria-label="Open menu" aria-expanded="false">
          <Icon name="Menu" class="h-4 w-4 sm:h-5 sm:w-5" />
        </button>
      </div>
    </div>

    <div data-mobile-menu data-open="false" class="mt-2 hidden max-h-[82vh] overflow-auto rounded-2xl border border-ink/10 bg-white p-3 text-ink shadow-lift backdrop-blur-xl data-[open=true]:block xl:hidden">
      <div class="grid gap-1.5">
        <a data-nav-close href="/" class="rounded-xl bg-linen px-3 py-2 text-sm font-extrabold">Home</a>
        <div>
          <button type="button" data-mobile-services-toggle aria-expanded="false" class="flex w-full items-center justify-between rounded-xl bg-linen px-3 py-2 text-left text-sm font-extrabold">
            <span>Services</span>
            <span class="text-brass" data-mobile-services-symbol>+</span>
          </button>
          <div class="mobile-accordion-panel rounded-2xl bg-white/70 data-[open=true]:mt-2 data-[open=true]:border data-[open=true]:border-ink/10" data-mobile-services-panel>
            <div class="grid gap-1 p-3">
              {services.map((service) => (
                <div class="rounded-xl bg-white" data-mobile-service-item>
                  {service.subServices.length > 0 ? (
                    <>
                      <button type="button" data-mobile-service-toggle aria-expanded="false" class="flex w-full items-center justify-between gap-3 rounded-xl px-3 py-2.5 text-left text-sm font-extrabold text-ink">
                        <span class="flex min-w-0 items-center gap-2">
                          <Icon name={service.icon} class="h-4 w-4 shrink-0 text-brass" />
                          <span class="truncate">{service.name}</span>
                        </span>
                        <span class="text-brass" data-mobile-service-symbol>+</span>
                      </button>
                      <div class="mobile-accordion-panel" data-mobile-service-panel>
                        <div class="grid gap-1 px-5 pb-3 pl-9" data-more-group>
                          {service.subServices.slice(0, 5).map((sub) => (
                            <a data-nav-close class="rounded-lg px-2 py-1.5 text-sm font-semibold leading-snug text-graphite/80 hover:bg-linen hover:text-ink" href={subServicePath(service, sub)}>{sub.name}</a>
                          ))}
                          {service.subServices.length > 5 && (
                            <>
                              <div class="more-panel" data-more-panel>
                                <div class="grid gap-1">
                                  {service.subServices.slice(5).map((sub) => (
                                    <a data-nav-close class="rounded-lg px-2 py-1.5 text-sm font-semibold leading-snug text-graphite/80 hover:bg-linen hover:text-ink" href={subServicePath(service, sub)}>{sub.name}</a>
                                  ))}
                                </div>
                              </div>
                              <button type="button" class="justify-self-start rounded-lg px-2 py-1.5 text-sm font-extrabold text-brass" data-more-toggle data-more-count={service.subServices.length - 5} aria-expanded="false">
                                + {service.subServices.length - 5} More
                              </button>
                            </>
                          )}
                        </div>
                      </div>
                    </>
                  ) : (
                    <a data-nav-close href={`/services/${service.slug}`} class="flex items-center gap-2 rounded-xl px-3 py-2.5 text-sm font-extrabold text-ink">
                      <Icon name={service.icon} class="h-4 w-4 shrink-0 text-brass" />
                      <span class="min-w-0 truncate">{service.name}</span>
                    </a>
                  )}
                </div>
              ))}
            </div>
          </div>
        </div>
        <a data-nav-close href="/about" class="rounded-xl bg-linen px-3 py-2 text-sm font-extrabold">About</a>
        <a data-nav-close href="/blog" class="rounded-xl bg-linen px-3 py-2 text-sm font-extrabold">Blog</a>
        <a data-nav-close href="/contact" class="rounded-xl bg-linen px-3 py-2 text-sm font-extrabold">Contact</a>
        <div class="grid gap-2 pt-2 min-[420px]:grid-cols-3">
          <a data-nav-close href="/request-quote" class="btn-brass">Get Quote</a>
          <a data-nav-close href={contact.phoneHref} class="btn-outline">Call {contact.phone}</a>
          <a data-nav-close href={contact.whatsappHref} class="btn-outline">WhatsApp</a>
        </div>
      </div>

    </div>

    <div data-mega-menu data-open="false" class="pointer-events-none invisible fixed left-1/2 top-20 z-50 hidden max-h-[calc(100vh-6rem)] w-[min(1120px,calc(100vw-32px))] -translate-x-1/2 translate-y-2 overflow-hidden rounded-[2rem] border border-ink/10 bg-paper p-4 opacity-0 shadow-lift transition duration-200 data-[open=true]:pointer-events-auto data-[open=true]:visible data-[open=true]:translate-y-0 data-[open=true]:opacity-100 lg:block">
      <div class="grid max-h-[calc(100vh-9rem)] grid-cols-1 gap-3 overflow-auto pr-1 sm:grid-cols-2 lg:max-h-[70vh] lg:grid-cols-3 xl:grid-cols-4">
        {services.map((service) => (
          <div class="rounded-2xl border border-ink/10 bg-white p-4 transition hover:border-brass/50">
            <a href={`/services/${service.slug}`} class="group flex items-center gap-3">
              <span class="grid h-10 w-10 place-items-center rounded-xl bg-linen text-brass transition group-hover:bg-ink"><Icon name={service.icon} class="h-5 w-5" /></span>
              <span>
                <span class="block font-display text-sm font-extrabold">{service.name}</span>
                <span class="text-xs font-semibold text-graphite/70">{service.subServices.length} sub-services</span>
              </span>
            </a>
            {service.subServices.length > 0 && (
              <ul class="mt-3 space-y-1 pl-13" data-more-group>
                {service.subServices.slice(0, 5).map((sub) => (
                  <li><a class="block rounded-lg px-2 py-1 text-xs font-semibold text-graphite/75 hover:bg-linen hover:text-ink" href={subServicePath(service, sub)}>{sub.name}</a></li>
                ))}
                {service.subServices.length > 5 && (
                  <>
                    <li class="more-panel" data-more-panel>
                      <ul class="space-y-1">
                        {service.subServices.slice(5).map((sub) => (
                          <li><a class="block rounded-lg px-2 py-1 text-xs font-semibold text-graphite/75 hover:bg-linen hover:text-ink" href={subServicePath(service, sub)}>{sub.name}</a></li>
                        ))}
                      </ul>
                    </li>
                    <li class="pt-1">
                      <button type="button" class="rounded-lg px-2 py-1 text-left text-xs font-extrabold text-brass transition hover:bg-linen hover:text-ink" data-more-toggle data-more-count={service.subServices.length - 5} aria-expanded="false">
                        + {service.subServices.length - 5} More
                      </button>
                    </li>
                  </>
                )}
              </ul>
            )}
          </div>
        ))}
      </div>
    </div>
  </div>
</header>
