---
import Icon from './Icon.astro';
import {
  allDistricts,
  certifications,
  locationDetails,
  recentProjects,
  recognitions,
  testimonials
} from '@/data/homeSections.js';
---

<section id="customer-reviews" class="section-padding bg-linen/70">
  <div class="container-shell">
    <div class="grid gap-8 lg:grid-cols-[0.78fr_1fr] lg:items-end">
      <div class="reveal">
        <span class="eyebrow">Customer Reviews</span>
        <h2 class="section-title mt-4">Trusted by Singapore homeowners for tidy, reliable work.</h2>
        <p class="mt-4 max-w-xl leading-7 text-graphite/75">Over 1,200 completed jobs across HDB flats, condos, and private homes, with clear quotes and careful finishing at every visit.</p>
      </div>
      <div class="reveal rounded-[2rem] border border-ink/10 bg-paper p-6 shadow-soft">
        <div class="flex flex-wrap items-center gap-4">
          <div class="flex gap-1 text-brass">{Array.from({ length: 5 }).map(() => <Icon name="Star" class="h-5 w-5 fill-current" />)}</div>
          <span class="font-display text-4xl font-extrabold">4.9</span>
          <span class="text-sm font-bold text-graphite/70">/ 5 based on 1,200+ reviews</span>
        </div>
      </div>
    </div>
    <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {testimonials.map((item, index) => (
        <article class="reveal flex min-h-[17rem] flex-col rounded-[1.5rem] border border-ink/10 bg-white p-6 shadow-soft" style={`transition-delay:${index * 45}ms`}>
          <div class="flex gap-0.5 text-brass">{Array.from({ length: item.rating }).map(() => <Icon name="Star" class="h-4 w-4 fill-current" />)}</div>
          <p class="mt-4 flex-1 text-sm leading-7 text-graphite/75">"{item.text}"</p>
          <div class="mt-5 border-t border-ink/10 pt-4">
            <p class="font-display text-sm font-extrabold">{item.name}</p>
            <p class="text-xs font-semibold text-graphite/60">{item.area}</p>
            <p class="mt-1 text-xs font-extrabold text-brass">{item.service}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<section id="recognition" class="premium-section section-padding bg-paper">
  <div class="container-shell">
    <div class="mx-auto max-w-3xl text-center reveal">
      <span class="eyebrow">Recognition & Certifications</span>
      <h2 class="section-title mt-4">Professional standards customers can feel on site.</h2>
      <p class="mt-4 leading-7 text-graphite/75">Recognised for service excellence, safe workmanship, transparent pricing, and responsive support across Singapore home services.</p>
    </div>
    <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {recognitions.map((item, index) => (
        <article class="premium-card reveal rounded-[1.5rem] border border-ink/10 bg-white p-6 shadow-soft transition duration-300 hover:-translate-y-1 hover:shadow-lift" style={`transition-delay:${index * 65}ms`}>
          <div class="flex items-start justify-between gap-3">
            <span class="premium-icon grid h-11 w-11 place-items-center rounded-xl bg-linen text-brass"><Icon name="Award" class="h-5 w-5" /></span>
            <span class="premium-badge rounded-full bg-brass/10 px-3 py-1 text-xs font-extrabold text-brass">{item.year}</span>
          </div>
          <h3 class="premium-heading mt-5 font-display text-lg font-extrabold leading-snug">{item.title}</h3>
          <p class="premium-meta mt-1 text-xs font-extrabold text-brass">{item.body}</p>
          <p class="premium-muted mt-4 text-sm leading-7">{item.desc}</p>
        </article>
      ))}
    </div>
    <div class="mt-10 flex flex-wrap justify-center gap-3 reveal">
      {certifications.map((cert) => (
        <span class="premium-chip inline-flex items-center gap-2 rounded-full border border-ink/10 bg-linen/70 px-4 py-2 text-sm font-extrabold text-graphite shadow-sm transition duration-300 hover:-translate-y-0.5">
          <Icon name="CheckCircle2" class="h-4 w-4 text-brass" /> {cert}
        </span>
      ))}
    </div>
  </div>
</section>

<section id="service-locations" class="premium-section section-padding bg-mist">
  <div class="container-shell">
    <div class="grid gap-8 lg:grid-cols-[0.82fr_1fr] lg:items-start">
      <div class="reveal">
        <span class="eyebrow">Service Locations</span>
        <h2 class="section-title mt-4">Handyman coverage across all Singapore districts.</h2>
        <p class="mt-4 leading-7 text-graphite/75">From Woodlands in the north to Changi in the east and Jurong in the west, the service flow is built for islandwide HDB, condo, office, and shop requests.</p>
        <a href="/request-quote" class="btn-brass mt-7">Check Availability <Icon name="ArrowRight" class="h-4 w-4" /></a>
      </div>
      <div class="grid gap-3 sm:grid-cols-2">
        {locationDetails.map((item, index) => (
          <article class="premium-card reveal rounded-[1.35rem] border border-ink/10 bg-paper p-5 shadow-soft transition duration-300 hover:-translate-y-1 hover:shadow-lift" style={`transition-delay:${index * 55}ms`}>
            <h3 class="premium-heading flex items-center gap-3 font-display text-base font-extrabold">
              <span class="premium-dot h-2.5 w-2.5 rounded-full bg-brass"></span>
              {item.area}
            </h3>
            <p class="premium-muted mt-3 text-sm leading-7">{item.desc}</p>
          </article>
        ))}
      </div>
    </div>
    <div class="premium-card mt-10 rounded-[1.5rem] border border-ink/10 bg-paper p-6 text-center shadow-soft reveal transition duration-300 hover:-translate-y-1 hover:shadow-lift">
      <p class="premium-heading font-display text-xl font-extrabold">Every HDB town and residential district in Singapore</p>
      <p class="premium-muted mx-auto mt-3 max-w-5xl text-sm leading-7">{allDistricts.join(' / ')}</p>
    </div>
  </div>
</section>

<section id="recent-projects" class="premium-section section-padding bg-paper">
  <div class="container-shell">
    <div class="max-w-3xl reveal">
      <span class="eyebrow">Recent Projects</span>
      <h2 class="section-title mt-4">Completed works with clean finishes and clear scope.</h2>
      <p class="mt-4 leading-7 text-graphite/75">A sample of recent handyman, renovation, maintenance, and installation jobs completed for Singapore homes.</p>
    </div>
    <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {recentProjects.map((project, index) => (
        <article class="premium-card group reveal overflow-hidden rounded-[1.5rem] border border-ink/10 bg-white shadow-soft transition duration-300 hover:shadow-lift" style={`transition-delay:${index * 55}ms`}>
          <div class="p-4 pb-0">
            <div class="relative aspect-[16/7] overflow-hidden rounded-[1.1rem] bg-linen">
              <img src={project.img} alt={`${project.title} completed by Pro Handyman SG`} class="h-full w-full object-cover transition-transform duration-[950ms] ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:scale-[1.035]" loading="lazy" />
              <span class="premium-image-badge absolute left-3 top-3 rounded-full bg-ink/88 px-3 py-1 text-xs font-extrabold text-white backdrop-blur">{project.category}</span>
            </div>
          </div>
          <div class="p-5">
            <h3 class="premium-heading font-display text-lg font-extrabold leading-snug">{project.title}</h3>
            <p class="premium-muted mt-3 text-sm leading-7">{project.desc}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
