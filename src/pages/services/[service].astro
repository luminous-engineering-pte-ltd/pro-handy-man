---
import BaseLayout from '@/layouts/BaseLayout.astro';
import CTA from '@/components/CTA.astro';
import FAQ from '@/components/FAQ.astro';
import Icon from '@/components/Icon.astro';
import { serviceSummary, subServicePath } from '@/data/services.js';
import { getServices, resolveSeo } from '@/lib/sanity/content.js';

export async function getStaticPaths() {
  const services = await getServices();
  return services.map((service) => ({ params: { service: service.slug }, props: { service } }));
}

const { service } = Astro.props;
const services = await getServices();
const related = services.filter((item) => item.slug !== service.slug).slice(0, 4);
const faq = service.faqs || [
  { q: `What does ${service.name} include?`, a: `${service.name} covers the service family shown on this page. Use the sub-service links for more specific tasks where available.` },
  { q: 'Can I request this for a home or office?', a: 'The quote form supports residential, office, retail, commercial, and property-related requests in Singapore.' },
  { q: 'What information should I provide?', a: 'Share the property type, location, preferred timing, photos if useful, and a short description of what needs to be fixed, installed, removed, or assessed.' }
];
const schema = [{
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: `${service.name} Singapore`,
  provider: { '@type': 'LocalBusiness', name: 'Pro Handyman SG', url: 'https://www.prohandymansg.com' },
  areaServed: { '@type': 'Country', name: 'Singapore' },
  description: serviceSummary(service)
}];
const seo = resolveSeo(service.seo, {
  title: `${service.name} Singapore | Pro Handyman SG`,
  description: serviceSummary(service),
  canonical: `https://www.prohandymansg.com/services/${service.slug}`,
  image: service.image
});
---

<BaseLayout title={seo.title} description={seo.description} canonical={seo.canonical} image={seo.image} noIndex={seo.noIndex} schema={schema}>
  <section class="relative overflow-hidden bg-ink pt-32 text-white">
    <img src={service.image} alt={`${service.name} service in Singapore`} class="absolute inset-0 h-full w-full object-cover opacity-35" />
    <div class="absolute inset-0 bg-gradient-to-r from-ink via-ink/88 to-ink/30"></div>
    <div class="container-shell relative pb-20">
      <a href="/services" class="inline-flex items-center gap-2 text-sm font-bold text-white/75 hover:text-white">Services</a>
      <div class="mt-8 max-w-3xl">
        <span class="eyebrow border-white/20 bg-white/10 text-brass">{service.category}</span>
        <h1 class="mt-5 font-display text-5xl font-extrabold leading-tight sm:text-6xl">{service.name} in Singapore</h1>
        <p class="mt-5 text-lg leading-8 text-white/75">{serviceSummary(service)}</p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a href="/request-quote" class="btn-brass">Request Quote <Icon name="ArrowRight" class="h-4 w-4" /></a>
          <a href="#included" class="inline-flex items-center justify-center rounded-full border border-white/25 px-5 py-3 text-sm font-extrabold text-white hover:bg-white/10">View Included Work</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section-padding">
    <div class="container-shell grid gap-10 lg:grid-cols-[0.9fr_1.1fr]">
      <div class="reveal">
        <span class="eyebrow">Service Detail</span>
        <h2 class="section-title mt-4">{service.tagline || 'Planned around your space, scope, and schedule.'}</h2>
        <p class="mt-4 leading-8 text-graphite/80">{service.intro || 'Choose the right job type, share the site details, and plan the work with a clear quote request.'}</p>
      </div>
      <div class="grid gap-4 sm:grid-cols-2">
        {[
          ['Clear work scope', 'Upfront details before work starts.'],
          ['Same-day slots', 'Fast scheduling when availability allows.'],
          ['Tidy workmanship', 'Clean, careful work for lived-in spaces.'],
          ['Quality guarantee', 'A professional finish customers can trust.']
        ].map(([item, text]) => (
          <article class="reveal rounded-[1.5rem] border border-ink/10 bg-white p-6 shadow-soft">
            <Icon name="CheckCircle2" class="h-6 w-6 text-brass" />
            <h3 class="mt-4 font-display text-xl font-extrabold">{item}</h3>
            <p class="mt-2 text-sm leading-6 text-graphite/70">{text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  {service.sections?.length > 0 && (
    <section class="section-padding bg-paper">
      <div class="container-shell">
        <div class="max-w-3xl reveal">
          <span class="eyebrow">What To Expect</span>
          <h2 class="section-title mt-4">Detailed {service.name.toLowerCase()} support for Singapore properties.</h2>
        </div>
        <div class="mt-10 grid gap-5 lg:grid-cols-3">
          {service.sections.map((section, index) => (
            <article class="premium-card reveal rounded-[1.5rem] border border-ink/10 bg-white p-6 shadow-soft transition duration-300 hover:-translate-y-1 hover:shadow-lift" style={`transition-delay:${index * 70}ms`}>
              <span class="font-display text-3xl font-extrabold text-brass">{String(index + 1).padStart(2, '0')}</span>
              <h3 class="premium-heading mt-5 font-display text-xl font-extrabold leading-snug">{section.h}</h3>
              <p class="premium-muted mt-3 text-sm leading-7">{section.p}</p>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <section id="included" class="section-padding bg-linen">
    <div class="container-shell">
      <div class="max-w-3xl">
        <span class="eyebrow">Included Services</span>
        <h2 class="section-title mt-4">{service.subServices.length ? `${service.name} sub-services` : `${service.name} overview`}</h2>
      </div>
      {service.subServices.length ? (
        <div class="mt-10 grid gap-4 md:grid-cols-2 xl:grid-cols-3">
          {service.subServices.map((sub) => (
            <a class="group rounded-[1.5rem] border border-ink/10 bg-white p-6 shadow-soft transition hover:-translate-y-1 hover:border-brass" href={subServicePath(service, sub)}>
              <Icon name={service.icon} class="h-6 w-6 text-brass" />
              <h3 class="mt-4 font-display text-xl font-extrabold">{sub.name}</h3>
              <p class="mt-3 text-sm leading-7 text-graphite/75">{sub.desc || `Dedicated page for ${sub.name.toLowerCase()} quote requests and planning details.`}</p>
              <span class="mt-5 inline-flex items-center gap-2 text-sm font-extrabold text-brass">View details <Icon name="ArrowRight" class="h-4 w-4 transition group-hover:translate-x-1" /></span>
            </a>
          ))}
        </div>
      ) : (
        <div class="mt-10 rounded-[1.5rem] border border-ink/10 bg-white p-8 shadow-soft">
          <p class="text-lg leading-8 text-graphite/80">No sub-services were defined for this main service in the source project, so it is preserved as a standalone service category.</p>
        </div>
      )}
    </div>
  </section>

  <section class="section-padding">
    <div class="container-shell">
      <span class="eyebrow">Related Services</span>
      <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {related.map((item) => (
          <a class="rounded-[1.5rem] border border-ink/10 bg-white p-5 shadow-soft transition hover:-translate-y-1 hover:border-brass" href={`/services/${item.slug}`}>
            <Icon name={item.icon} class="h-6 w-6 text-brass" />
            <h3 class="mt-4 font-display text-lg font-extrabold">{item.name}</h3>
          </a>
        ))}
      </div>
    </div>
  </section>

  <FAQ title={`${service.name} questions`} items={faq} />
  <CTA title={`Need ${service.name.toLowerCase()} help?`} />
</BaseLayout>
