---
import BaseLayout from '@/layouts/BaseLayout.astro';
import CTA from '@/components/CTA.astro';
import FAQ from '@/components/FAQ.astro';
import Icon from '@/components/Icon.astro';
import { subServiceSummary, subServicePath } from '@/data/services.js';
import { getServices, resolveSeo } from '@/lib/sanity/content.js';

export async function getStaticPaths() {
  const services = await getServices();
  return services.flatMap((service) =>
    service.subServices.map((subService) => ({
      params: { service: service.slug, subservice: subService.slug },
      props: { service, subService }
    }))
  );
}

const { service, subService } = Astro.props;
const services = await getServices();
const siblings = service.subServices.filter((item) => item.slug !== subService.slug).slice(0, 6);
const summary = subServiceSummary(subService, service);
const faq = subService.faqs || [
  { q: `Can I request ${subService.name} directly?`, a: `Yes. Select ${service.name} in the quote form and mention ${subService.name} in the details so the request is routed with the right context.` },
  { q: 'Do I need to provide photos?', a: 'Photos are optional, but they can make the quote request clearer for repairs, installations, dismantling, wall work, fixtures, or appliance issues.' },
  { q: 'Is this available across Singapore?', a: 'Yes. Pro Handyman SG handles service requests across Singapore for HDB flats, condos, landed homes, offices, shops, and commercial properties.' }
];
const schema = [{
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: `${subService.name} Singapore`,
  serviceType: service.name,
  provider: { '@type': 'LocalBusiness', name: 'Pro Handyman SG', url: 'https://www.prohandymansg.com' },
  areaServed: { '@type': 'Country', name: 'Singapore' },
  description: summary
}];
const seo = resolveSeo(subService.seo, {
  title: `${subService.name} Singapore | Pro Handyman SG`,
  description: summary,
  canonical: `https://www.prohandymansg.com${subServicePath(service, subService)}`,
  image: service.image
});
---

<BaseLayout title={seo.title} description={seo.description} canonical={seo.canonical} image={seo.image} noIndex={seo.noIndex} schema={schema}>
  <section class="bg-linen pt-32">
    <div class="container-shell grid gap-10 pb-16 lg:grid-cols-[1fr_0.82fr] lg:items-center">
      <div class="reveal is-visible">
        <div class="flex flex-wrap items-center gap-2 text-sm font-bold text-graphite/70">
          <a href="/services" class="hover:text-ink">Services</a>
          <span>/</span>
          <a href={`/services/${service.slug}`} class="hover:text-ink">{service.name}</a>
        </div>
        <span class="eyebrow mt-6">{service.category}</span>
        <h1 class="mt-5 font-display text-5xl font-extrabold leading-tight sm:text-6xl">{subService.name}</h1>
        <p class="mt-5 max-w-2xl text-lg leading-8 text-graphite/80">{subService.intro || summary}</p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a href="/request-quote" class="btn-brass">Request Quote <Icon name="ArrowRight" class="h-4 w-4" /></a>
          <a href={`/services/${service.slug}`} class="btn-outline">Back to {service.name}</a>
        </div>
      </div>
      <div class="reveal is-visible overflow-hidden rounded-[2rem] shadow-lift">
        <img src={service.image} alt={`${subService.name} under ${service.name} in Singapore`} class="aspect-[4/3] w-full object-cover" />
      </div>
    </div>
  </section>

  <section class="section-padding">
    <div class="container-shell">
      <div class="max-w-3xl reveal">
        <span class="eyebrow">Service Scope</span>
        <h2 class="section-title mt-4">Clean, properly planned {subService.name.toLowerCase()}.</h2>
      </div>
      <div class="mt-10 grid gap-5 lg:grid-cols-3">
        {(subService.sections || [
          { h: 'Assess', p: 'Share the issue, item, room, fixture, or site condition.' },
          { h: 'Quote', p: 'Use the form details to shape a clearer work estimate.' },
          { h: 'Schedule', p: 'Choose a preferred date and time window for follow-up.' }
        ]).map((section, index) => (
          <article class="premium-card reveal rounded-[1.5rem] border border-ink/10 bg-white p-6 shadow-soft transition duration-300 hover:-translate-y-1 hover:shadow-lift" style={`transition-delay:${index * 70}ms`}>
            <Icon name="ClipboardCheck" class="h-7 w-7 text-brass" />
            <h2 class="premium-heading mt-5 font-display text-2xl font-extrabold">{section.h}</h2>
            <p class="premium-muted mt-3 leading-7">{section.p}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  {subService.covers?.length > 0 && (
    <section class="section-padding bg-linen">
      <div class="container-shell grid gap-8 lg:grid-cols-[0.78fr_1fr] lg:items-start">
        <div class="reveal">
          <span class="eyebrow">Included Work</span>
          <h2 class="section-title mt-4">Common tasks covered in this service.</h2>
        </div>
        <div class="grid gap-3 sm:grid-cols-2">
          {subService.covers.map((item, index) => (
            <div class="reveal rounded-2xl border border-ink/10 bg-white p-4 shadow-soft" style={`transition-delay:${index * 40}ms`}>
              <Icon name="CheckCircle2" class="h-5 w-5 text-brass" />
              <p class="mt-2 text-sm font-extrabold leading-6">{item}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  {siblings.length > 0 && (
    <section class="section-padding">
      <div class="container-shell">
        <span class="eyebrow">Related {service.name}</span>
        <h2 class="section-title mt-4">More options in this service family</h2>
        <div class="mt-8 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
          {siblings.map((item) => (
            <a class="rounded-[1.5rem] border border-ink/10 bg-white p-5 shadow-soft transition hover:-translate-y-1 hover:border-brass" href={subServicePath(service, item)}>
              <h3 class="font-display text-lg font-extrabold">{item.name}</h3>
              <p class="mt-3 text-sm leading-6 text-graphite/70">View the dedicated detail page.</p>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <FAQ title={`${subService.name} questions`} items={faq} />
  <CTA title={`Request ${subService.name.toLowerCase()} support`} />
</BaseLayout>
