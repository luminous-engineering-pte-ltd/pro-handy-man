---
import BaseLayout from '@/layouts/BaseLayout.astro';
import CTA from '@/components/CTA.astro';
import Icon from '@/components/Icon.astro';
---

<BaseLayout title="About Pro Handyman SG | Professional Handyman Services Singapore" description="Learn about Pro Handyman SG, a Singapore-focused handyman services website for residential, commercial, office, and property work." canonical="https://prohandymansg.com/about">
  <section class="bg-linen pt-32">
    <div class="container-shell grid gap-10 pb-16 lg:grid-cols-[1fr_0.85fr] lg:items-center">
      <div>
        <span class="eyebrow">About</span>
        <h1 class="mt-5 font-display text-5xl font-extrabold leading-tight sm:text-6xl">A clearer way to book handyman work in Singapore.</h1>
        <p class="mt-5 max-w-2xl text-lg leading-8 text-graphite/80">Pro Handyman SG is presented as a professional service brand for homeowners, tenants, offices, shops, and property teams who need repairs, installations, maintenance, and improvement work explained clearly.</p>
      </div>
      <img src="https://images.unsplash.com/photo-1600607688969-a5bfcd646154?auto=format&fit=crop&w=1400&q=80" alt="Modern Singapore home interior suitable for handyman services" class="rounded-[2rem] shadow-lift" />
    </div>
  </section>

  <section class="section-padding">
    <div class="container-shell grid gap-4 md:grid-cols-3">
      {[
        ['Quality mindset', 'Service pages are structured around careful scoping, tidy completion, and clear expectations.'],
        ['Customer-first UX', 'The site helps visitors search by the task they actually need, from locks and taps to reinstatement.'],
        ['Singapore context', 'Content is framed for HDB, condos, offices, shops, and commercial properties across Singapore.']
      ].map(([title, text]) => (
        <article class="reveal rounded-[1.5rem] border border-ink/10 bg-white p-6 shadow-soft">
          <Icon name="ShieldCheck" class="h-7 w-7 text-brass" />
          <h2 class="mt-5 font-display text-xl font-extrabold">{title}</h2>
          <p class="mt-3 text-sm leading-7 text-graphite/75">{text}</p>
        </article>
      ))}
    </div>
  </section>

  <CTA title="Have a repair or installation to plan?" />
</BaseLayout>
