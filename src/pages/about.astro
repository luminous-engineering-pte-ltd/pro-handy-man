---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/Icon.astro';
import { servicePath, serviceSummary } from '@/data/services.js';
import { getFixedPage, getServices, getSiteSettings, resolveSeo } from '@/lib/sanity/content.js';

const services = await getServices();
const { contact } = await getSiteSettings();
const page = await getFixedPage('about');
const flooringService = services.find((service) => service.slug === 'flooring');
const totalSubServices = services.reduce((count, service) => count + service.subServices.length, 0);

const featuredServiceSlugs = [
  'flooring',
  'painting',
  'renovation-services',
  'hacking-dismantling-disposal',
  'carpentry-service',
  'general-repairs'
];

const featuredServices = featuredServiceSlugs.map((slug) => services.find((service) => service.slug === slug)).filter(Boolean);

const reasons = [
  ['ShieldCheck', 'Clear, careful scope', 'Every enquiry is approached with a proper understanding of the surface, site condition, access, timing, and finish expectations before work begins.'],
  ['Layers', 'Flooring-led expertise', 'From vinyl and laminate to parquet repair, tiles, carpet, and epoxy, the service structure is built around real flooring needs in Singapore spaces.'],
  ['ClipboardCheck', 'Transparent workflow', 'Quotes, recommended works, preparation steps, and handover expectations are communicated clearly so customers know what is happening next.'],
  ['Sparkles', 'Premium finishing mindset', 'The focus is not only on completing the task, but on clean edges, tidy protection, smooth surfaces, and a finish that feels professionally handled.'],
  ['Clock3', 'Responsive coordination', 'Residential and commercial requests are planned around practical schedules, property rules, and the urgency of the repair or improvement.'],
  ['MapPin', 'Singapore property context', 'Content and services are framed for HDB flats, condos, landed homes, offices, retail units, and commercial properties across Singapore.']
];

const processSteps = [
  ['Search', 'Inspect & understand', 'We begin with the flooring issue, property type, dimensions, existing surface, and any repair, polishing, varnishing, or restoration goals.'],
  ['ClipboardCheck', 'Recommend the right scope', 'The work is clarified into practical options so customers can compare what is necessary, optional, and best suited for the space.'],
  ['ShieldCheck', 'Prepare the area', 'Protection, access, removal, cleaning, and surface preparation are planned to keep the surrounding space tidy and workable.'],
  ['Hammer', 'Complete the service', 'Flooring, repair, restoration, varnishing, painting, carpentry, and related works are handled with steady workmanship and attention to detail.'],
  ['CheckCircle2', 'Review & handover', 'The completed work is checked for finish quality, cleanliness, and readiness so the space can return to everyday use with confidence.']
];

const commitments = [
  'Quality workmanship that respects the property and the final finish.',
  'Reliable communication from first enquiry through completion.',
  'Transparent recommendations without unnecessary complexity.',
  'Customer satisfaction shaped by clean work, clear scope, and dependable follow-through.'
];

const stats = [
  [`${services.length}+`, 'Main service categories'],
  [`${totalSubServices}+`, 'Detailed sub-services'],
  ['Islandwide', 'Singapore coverage'],
  ['Homes + Commercial', 'Property types supported']
];
const seo = resolveSeo(page?.seo, {
  title: 'About Pro Handyman SG | Premium Flooring & Handyman Services Singapore',
  description: 'Learn about Pro Handyman SG, a Singapore flooring and handyman service brand focused on floor polishing, repair, varnishing, restoration, and professional property works.',
  canonical: 'https://www.prohandymansg.com/about'
});
---

<BaseLayout title={seo.title} description={seo.description} canonical={seo.canonical} image={seo.image} noIndex={seo.noIndex}>
  <section class="relative overflow-hidden bg-linen pt-28 sm:pt-32 lg:pt-36">
    <div class="absolute inset-x-0 top-0 h-32 bg-gradient-to-b from-brass/10 to-transparent"></div>
    <div class="container-shell relative grid gap-10 pb-16 lg:grid-cols-[1fr_0.92fr] lg:items-center">
      <div class="reveal is-visible min-w-0">
        <span class="eyebrow">{page?.eyebrow || 'About Us'}</span>
        <h1 class="mt-5 font-display text-4xl font-extrabold leading-tight text-ink sm:text-5xl lg:text-6xl">{page?.title || 'Premium flooring care, repairs, and property works for Singapore spaces.'}</h1>
        <p class="mt-5 max-w-2xl text-base leading-8 text-graphite/80 sm:text-lg">
          {page?.intro || 'Pro Handyman SG helps homeowners, tenants, offices, shops, and property teams plan flooring, repair, installation, restoration, and maintenance work with clarity. The aim is simple: make every enquiry feel professional, transparent, and easy to move from problem to polished result.'}
        </p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a href="/request-quote" class="btn-brass w-full sm:w-auto">Get a Free Quote <Icon name="ArrowRight" class="h-4 w-4" /></a>
          <a href="/services/flooring" class="btn-outline w-full sm:w-auto">Explore Flooring <Icon name="Layers" class="h-4 w-4" /></a>
        </div>
      </div>

      <div class="reveal is-visible">
        <div class="overflow-hidden rounded-[2rem] border border-ink/10 bg-white p-3 shadow-lift">
          <div class="relative overflow-hidden rounded-[1.5rem]">
            <img src={flooringService?.image || 'https://images.unsplash.com/photo-1581858726788-75bc0f6a952d?auto=format&fit=crop&w=1400&q=80'} alt="Premium flooring surface prepared for professional service" class="aspect-[4/3] w-full object-cover" />
            <div class="absolute inset-x-4 bottom-4 rounded-[1.25rem] border border-white/15 bg-ink/90 p-5 text-white shadow-lift backdrop-blur">
              <span class="text-xs font-extrabold uppercase tracking-[0.24em] text-brass">Flooring Focus</span>
              <p class="mt-2 font-display text-2xl font-extrabold">Polishing, repair, varnishing, and restoration support.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section-padding">
    <div class="container-shell grid gap-10 lg:grid-cols-[0.78fr_1fr] lg:items-start">
      <div class="reveal">
        <span class="eyebrow">Our Story</span>
        <h2 class="section-title mt-4">A clearer, more polished way to organise property work.</h2>
      </div>
      <div class="grid gap-5 text-base leading-8 text-graphite/78">
        <p class="reveal">
          Pro Handyman SG was shaped around a common problem: customers often know what feels wrong in their home or commercial space, but not which service, material, preparation, or repair path is the right one. The website brings those needs into a more organised service experience.
        </p>
        <p class="reveal">
          Flooring sits at the heart of that approach because it affects how a property looks, feels, and functions every day. Whether the requirement is floor polishing, floor repair, varnishing, tile work, surface restoration, or related finishing work, the experience is designed to help customers describe the issue clearly and request a practical quote with confidence.
        </p>
      </div>
    </div>
  </section>

  <section class="section-padding bg-ink text-white">
    <div class="container-shell grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {stats.map(([value, label], index) => (
        <article class="reveal rounded-[1.5rem] border border-white/10 bg-white/8 p-6 shadow-soft transition duration-300 hover:-translate-y-1 hover:border-brass/45" style={`transition-delay:${index * 55}ms`}>
          <p class="font-display text-3xl font-extrabold text-brass sm:text-4xl">{value}</p>
          <p class="mt-2 text-sm font-semibold text-white/80">{label}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="section-padding bg-linen/70">
    <div class="container-shell">
      <div class="mx-auto max-w-3xl text-center reveal">
        <span class="eyebrow">Why Choose Us</span>
        <h2 class="section-title mt-4">Professional standards that make the work feel calm, tidy, and dependable.</h2>
      </div>
      <div class="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        {reasons.map(([icon, title, text], index) => (
          <article class="premium-card reveal rounded-[1.5rem] border border-ink/10 bg-white p-6 shadow-soft transition duration-300 hover:-translate-y-1 hover:border-brass/45 hover:shadow-lift" style={`transition-delay:${index * 55}ms`}>
            <span class="grid h-12 w-12 place-items-center rounded-2xl bg-linen text-brass">
              <Icon name={icon} class="h-5 w-5" />
            </span>
            <h3 class="mt-5 font-display text-xl font-extrabold text-ink">{title}</h3>
            <p class="mt-3 text-sm leading-7 text-graphite/75">{text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section-padding">
    <div class="container-shell">
      <div class="grid gap-6 lg:grid-cols-[0.8fr_1fr] lg:items-end">
        <div class="reveal">
          <span class="eyebrow">Our Services</span>
          <h2 class="section-title mt-4">Flooring support backed by broader property expertise.</h2>
        </div>
        <p class="reveal text-base leading-8 text-graphite/75">
          Customers can begin with a flooring concern, then connect related needs such as painting, renovation, disposal, carpentry, or general repair work when the project requires a more complete property solution.
        </p>
      </div>

      <div class="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        {featuredServices.map((service, index) => (
          <a href={servicePath(service)} class="premium-card group reveal overflow-hidden rounded-[1.5rem] border border-ink/10 bg-white shadow-soft transition duration-300 hover:-translate-y-1 hover:border-brass/45 hover:shadow-lift" style={`transition-delay:${index * 60}ms`}>
            <div class="aspect-[16/9] overflow-hidden bg-linen">
              <img src={service.image} alt={`${service.name} service in Singapore`} class="h-full w-full object-cover transition duration-500 group-hover:scale-105" />
            </div>
            <div class="p-6">
              <div class="flex items-center justify-between gap-4">
                <span class="grid h-11 w-11 place-items-center rounded-xl bg-linen text-brass">
                  <Icon name={service.icon} class="h-5 w-5" />
                </span>
                <Icon name="ArrowRight" class="h-4 w-4 text-brass transition group-hover:translate-x-1" />
              </div>
              <h3 class="mt-5 font-display text-xl font-extrabold text-ink">{service.name}</h3>
              <p class="mt-3 line-clamp-3 text-sm leading-7 text-graphite/75">{serviceSummary(service)}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section-padding bg-linen">
    <div class="container-shell grid gap-10 lg:grid-cols-[0.8fr_1fr] lg:items-start">
      <div class="reveal lg:sticky lg:top-28">
        <span class="eyebrow">Our Process</span>
        <h2 class="section-title mt-4">From first inspection to finished handover.</h2>
        <p class="mt-5 text-base leading-8 text-graphite/75">
          A premium result depends on the steps before the tools come out: understanding the surface, planning preparation, setting expectations, and checking the finish properly.
        </p>
      </div>
      <div class="grid gap-4">
        {processSteps.map(([icon, title, text], index) => (
          <article class="reveal flex gap-4 rounded-[1.5rem] border border-ink/10 bg-white p-5 shadow-soft transition duration-300 hover:-translate-y-1 hover:border-brass/45 hover:shadow-lift" style={`transition-delay:${index * 55}ms`}>
            <span class="grid h-11 w-11 shrink-0 place-items-center rounded-xl bg-linen text-brass">
              <Icon name={icon} class="h-5 w-5" />
            </span>
            <div>
              <p class="text-xs font-extrabold uppercase tracking-[0.22em] text-brass">Step {index + 1}</p>
              <h3 class="mt-1 font-display text-xl font-extrabold text-ink">{title}</h3>
              <p class="mt-2 text-sm leading-7 text-graphite/75">{text}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section-padding">
    <div class="container-shell grid gap-6 lg:grid-cols-2">
      <article class="premium-card reveal rounded-[2rem] border border-ink/10 bg-white p-6 shadow-soft sm:p-8 lg:p-10">
        <span class="grid h-12 w-12 place-items-center rounded-2xl bg-linen text-brass">
          <Icon name="Award" class="h-5 w-5" />
        </span>
        <h2 class="mt-6 font-display text-3xl font-extrabold text-ink">Quality & craftsmanship</h2>
        <p class="mt-4 text-base leading-8 text-graphite/75">
          Good flooring work is visible in the details: how surfaces are prepared, how repairs blend into the existing finish, how cleanly edges meet walls or fixtures, and how carefully the space is left after completion. Pro Handyman SG presents each flooring and property service around that standard of workmanship.
        </p>
      </article>

      <article class="premium-card reveal rounded-[2rem] border border-ink/10 bg-white p-6 shadow-soft sm:p-8 lg:p-10">
        <span class="grid h-12 w-12 place-items-center rounded-2xl bg-linen text-brass">
          <Icon name="ShieldCheck" class="h-5 w-5" />
        </span>
        <h2 class="mt-6 font-display text-3xl font-extrabold text-ink">Our commitment</h2>
        <ul class="mt-5 grid gap-3">
          {commitments.map((item) => (
            <li class="flex gap-3 text-sm leading-7 text-graphite/78">
              <Icon name="CheckCircle2" class="mt-1 h-5 w-5 shrink-0 text-brass" />
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </article>
    </div>
  </section>

  <section class="section-padding bg-linen/70">
    <div class="container-shell">
      <div class="reveal overflow-hidden rounded-[2rem] border border-ink/10 bg-ink p-6 text-white shadow-lift sm:p-8 lg:p-12">
        <div class="grid gap-8 lg:grid-cols-[1fr_auto] lg:items-center">
          <div>
            <span class="text-xs font-extrabold uppercase tracking-[0.24em] text-brass">Ready To Plan Your Floor?</span>
            <h2 class="mt-4 font-display text-3xl font-extrabold sm:text-4xl">Request a free quote for flooring, repair, restoration, or property work.</h2>
            <p class="mt-4 max-w-2xl text-base leading-8 text-white/75">
              Share your floor condition, photos, preferred timing, and service requirements. The enquiry can be reviewed around the right scope, finish expectations, and next steps.
            </p>
          </div>
          <div class="flex flex-col gap-3 sm:flex-row lg:flex-col">
            <a href="/request-quote" class="btn-brass justify-center">Get a Free Quote <Icon name="ArrowRight" class="h-4 w-4" /></a>
            <a href={contact.phoneHref} class="inline-flex items-center justify-center gap-2 rounded-full border border-white/15 px-5 py-3 text-sm font-extrabold text-white transition hover:-translate-y-0.5 hover:border-brass hover:text-brass">
              <Icon name="Phone" class="h-4 w-4" /> {contact.phone}
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
