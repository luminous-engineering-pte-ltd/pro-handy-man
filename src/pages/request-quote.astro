---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/Icon.astro';
import { services } from '@/data/services.js';
import { contact } from '@/data/contact.js';
const subOptions = services.flatMap((service) => service.subServices.map((sub) => `${service.name} - ${sub.name}`));
---

<BaseLayout title="Request a Handyman Quote Singapore | Pro Handyman SG" description="Request a handyman services quote from Pro Handyman SG. Choose a service, sub-service, property type, Singapore location, preferred date, and project details." canonical="https://prohandymansg.com/request-quote">
  <section class="bg-linen pt-32">
    <div class="container-shell grid gap-10 pb-16 lg:grid-cols-[0.72fr_1fr]">
      <div>
        <span class="eyebrow">Free Quote Request</span>
        <h1 class="mt-5 font-display text-5xl font-extrabold leading-tight sm:text-6xl">A better brief makes a better quote.</h1>
        <p class="mt-5 text-lg leading-8 text-graphite/80">Share the service, location, timing, property type, and project notes. Upload support is represented in the UI and ready to connect to a backend.</p>
        <div class="mt-8 grid gap-3">
          <a href={contact.phoneHref} class="flex items-center gap-3 rounded-2xl bg-white p-4 font-bold shadow-soft transition hover:-translate-y-0.5 hover:bg-linen">
            <Icon name="Phone" class="h-5 w-5 text-brass" /> Call {contact.phone}
          </a>
          <a href={contact.whatsappHref} class="flex items-center gap-3 rounded-2xl bg-white p-4 font-bold shadow-soft transition hover:-translate-y-0.5 hover:bg-linen">
            <Icon name="MessageSquare" class="h-5 w-5 text-brass" /> WhatsApp {contact.phone}
          </a>
          <a href={contact.emailHref} class="flex items-center gap-3 rounded-2xl bg-white p-4 font-bold shadow-soft transition hover:-translate-y-0.5 hover:bg-linen">
            <Icon name="Mail" class="h-5 w-5 text-brass" /> {contact.email}
          </a>
        </div>
      </div>
      <form data-enhanced-form class="rounded-[2rem] border border-ink/10 bg-white p-6 shadow-lift sm:p-8">
        <div class="grid gap-4 sm:grid-cols-2">
          <label class="grid gap-2 text-sm font-bold">Name <input required name="name" class="rounded-2xl border border-ink/10 px-4 py-3" /></label>
          <label class="grid gap-2 text-sm font-bold">Email <input required name="email" type="email" class="rounded-2xl border border-ink/10 px-4 py-3" placeholder={contact.email} /></label>
          <label class="grid gap-2 text-sm font-bold">Phone <input required name="phone" type="tel" class="rounded-2xl border border-ink/10 px-4 py-3" placeholder={contact.phone} /></label>
          <label class="grid gap-2 text-sm font-bold">Service <select required name="service" class="rounded-2xl border border-ink/10 px-4 py-3"><option value="">Choose service</option>{services.map((service) => <option>{service.name}</option>)}</select></label>
          <label class="grid gap-2 text-sm font-bold">Sub-service <select name="subservice" class="rounded-2xl border border-ink/10 px-4 py-3"><option value="">Optional</option>{subOptions.map((item) => <option>{item}</option>)}</select></label>
          <label class="grid gap-2 text-sm font-bold">Property type <select required name="property" class="rounded-2xl border border-ink/10 px-4 py-3"><option value="">Choose type</option><option>HDB</option><option>Condo</option><option>Apartment</option><option>Landed home</option><option>Office</option><option>Retail shop</option><option>Commercial property</option></select></label>
          <label class="grid gap-2 text-sm font-bold">Location <input required name="location" placeholder="Area in Singapore" class="rounded-2xl border border-ink/10 px-4 py-3" /></label>
          <label class="grid gap-2 text-sm font-bold">Preferred date <input name="date" type="date" class="rounded-2xl border border-ink/10 px-4 py-3" /></label>
          <label class="grid gap-2 text-sm font-bold">Preferred time <select name="time" class="rounded-2xl border border-ink/10 px-4 py-3"><option>Flexible</option><option>Morning</option><option>Afternoon</option><option>Evening</option></select></label>
          <label class="grid gap-2 text-sm font-bold sm:col-span-2">Project details <textarea required name="details" rows="6" class="rounded-2xl border border-ink/10 px-4 py-3" placeholder="Describe the repair, installation, measurement, item model, photos available, or access notes."></textarea></label>
          <label class="flex cursor-pointer items-center justify-between gap-3 rounded-2xl border border-dashed border-ink/20 bg-linen/70 p-4 text-sm font-bold sm:col-span-2">
            <span class="flex items-center gap-3"><Icon name="ClipboardCheck" class="h-5 w-5 text-brass" /> Optional image upload UI</span>
            <input type="file" class="sr-only" />
          </label>
        </div>
        <button class="btn-brass mt-6 w-full" type="submit">Submit Quote Request</button>
        <p data-success hidden class="mt-4 rounded-2xl bg-linen p-4 text-sm font-bold text-ink">Thanks. This static form interaction is ready for backend wiring.</p>
      </form>
    </div>
  </section>
</BaseLayout>
