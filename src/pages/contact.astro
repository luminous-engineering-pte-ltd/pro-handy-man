---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/Icon.astro';
import { getFixedPage, getServices, getSiteSettings, resolveSeo } from '@/lib/sanity/content.js';

const services = await getServices();
const { contact } = await getSiteSettings();
const page = await getFixedPage('contact');
const serviceOptions = [
  'Floor Polishing',
  'Floor Repair',
  'Floor Varnishing',
  'Surface Restoration',
  ...services.map((service) => service.name),
  'Other'
].filter((item, index, list) => list.indexOf(item) === index);

const contactCards = [
  {
    icon: 'Phone',
    title: 'Phone',
    value: contact.phone,
    href: contact.phoneHref,
    note: 'Speak with our service team'
  },
  {
    icon: 'Mail',
    title: 'Email',
    value: contact.email,
    href: contact.emailHref,
    note: 'Send plans, photos, or scope notes'
  },
  {
    icon: 'MapPin',
    title: 'Location',
    value: contact.area,
    href: null,
    note: 'Serving homes and commercial spaces'
  },
  {
    icon: 'Clock3',
    title: 'Business Hours',
    value: 'Mon-Sat, 9:00 AM-6:00 PM',
    href: null,
    note: 'Priority quotes by appointment'
  }
];

const trustItems = [
  ['Free quote', 'Clear next steps before work begins.'],
  ['Professional consultation', 'Practical advice for polishing, repair, varnishing, and restoration.'],
  ['Floor inspection enquiry', 'Share photos, access notes, and site details for a sharper estimate.']
];
const seo = resolveSeo(page?.seo, {
  title: 'Contact Pro Handyman SG | Flooring Quote Singapore',
  description: 'Contact Pro Handyman SG for premium floor polishing, repair, varnishing, surface restoration, and handyman service enquiries across Singapore.',
  canonical: 'https://www.prohandymansg.com/contact'
});
---

<BaseLayout title={seo.title} description={seo.description} canonical={seo.canonical} image={seo.image} noIndex={seo.noIndex}>
  <section class="relative overflow-hidden bg-linen pt-28 sm:pt-32 lg:pt-36">
    <div class="absolute inset-x-0 top-0 h-40 bg-gradient-to-b from-paper to-transparent"></div>
    <div class="absolute left-1/2 top-24 h-72 w-[min(900px,90vw)] -translate-x-1/2 rounded-full bg-brass/10 blur-3xl"></div>

    <div class="container-shell relative pb-14 sm:pb-16 lg:pb-18">
      <div class="grid gap-8 lg:grid-cols-[0.95fr_0.82fr] lg:items-center">
        <div class="reveal is-visible min-w-0">
          <span class="eyebrow">{page?.eyebrow || 'Get In Touch'}</span>
          <h1 class="mt-5 max-w-4xl text-balance font-display text-4xl font-extrabold leading-[1.04] tracking-tight text-ink sm:text-5xl lg:text-6xl">{page?.title || "Let's Transform Your Floor"}</h1>
          <p class="mt-5 max-w-2xl text-base leading-8 text-graphite/80 sm:text-lg">{page?.intro || 'Request a professional flooring quote for polishing, repair, varnishing, surface restoration, or related property works. Share your floor type, photos, access notes, and preferred timing so we can guide the next step clearly.'}</p>
          <div class="mt-7 flex flex-col gap-3 sm:flex-row">
            <a href="#quote-form" class="btn-brass w-full sm:w-auto">Get a Free Quote <Icon name="ArrowRight" class="h-4 w-4" /></a>
            <a href={contact.phoneHref} class="btn-outline w-full sm:w-auto"><Icon name="Phone" class="h-4 w-4" /> {contact.phone}</a>
          </div>
        </div>

        <div class="reveal is-visible">
          <div class="relative overflow-hidden rounded-[2rem] border border-ink/10 bg-white p-3 shadow-lift">
            <img src="https://images.unsplash.com/photo-1581858726788-75bc0f6a952d?auto=format&fit=crop&w=1200&q=82" alt="Premium timber flooring surface prepared for restoration" class="aspect-[16/10] w-full rounded-[1.5rem] object-cover" />
            <div class="absolute bottom-6 left-6 right-6 rounded-2xl bg-paper/92 p-4 backdrop-blur">
              <p class="text-xs font-extrabold uppercase tracking-[0.16em] text-brass">Flooring Enquiries</p>
              <p class="mt-1 font-display text-xl font-extrabold text-ink">Polishing, repair, varnishing, and restoration</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section-padding bg-paper">
    <div class="container-shell">
      <div class="grid gap-6 lg:grid-cols-[1.05fr_0.72fr] lg:items-start">
        <form id="quote-form" data-enhanced-form class="reveal rounded-[2rem] border border-ink/10 bg-white p-5 shadow-lift sm:p-7 lg:p-8">
          <div class="mb-6">
            <span class="text-xs font-extrabold uppercase tracking-[0.16em] text-brass">Quote Request</span>
            <h2 class="mt-2 font-display text-2xl font-extrabold text-ink sm:text-3xl">Tell us about your floor</h2>
            <p class="mt-2 text-sm leading-7 text-graphite/75">Fields marked with <span class="text-brass">*</span> are required.</p>
          </div>

          <div class="grid gap-4 sm:grid-cols-2">
            <label for="name" class="grid gap-2 text-sm font-extrabold text-ink">
              Name <span class="sr-only">required</span>
              <span class="relative">
                <Icon name="Home" class="pointer-events-none absolute left-4 top-1/2 h-4 w-4 -translate-y-1/2 text-brass" />
                <input id="name" name="name" required class="w-full rounded-2xl border border-ink/10 bg-paper px-11 py-3.5 text-sm text-ink transition hover:border-brass/45 focus:border-brass focus:bg-white aria-[invalid=true]:border-clay" placeholder="Your name" />
              </span>
            </label>

            <label for="email" class="grid gap-2 text-sm font-extrabold text-ink">
              Email <span class="sr-only">required</span>
              <span class="relative">
                <Icon name="Mail" class="pointer-events-none absolute left-4 top-1/2 h-4 w-4 -translate-y-1/2 text-brass" />
                <input id="email" name="email" required type="email" class="w-full rounded-2xl border border-ink/10 bg-paper px-11 py-3.5 text-sm text-ink transition hover:border-brass/45 focus:border-brass focus:bg-white aria-[invalid=true]:border-clay" placeholder={contact.email} />
              </span>
            </label>

            <label for="phone" class="grid gap-2 text-sm font-extrabold text-ink">
              Phone Number <span class="sr-only">required</span>
              <span class="relative">
                <Icon name="Phone" class="pointer-events-none absolute left-4 top-1/2 h-4 w-4 -translate-y-1/2 text-brass" />
                <input id="phone" name="phone" required type="tel" class="w-full rounded-2xl border border-ink/10 bg-paper px-11 py-3.5 text-sm text-ink transition hover:border-brass/45 focus:border-brass focus:bg-white aria-[invalid=true]:border-clay" placeholder={contact.phone} />
              </span>
            </label>

            <label for="service" class="grid gap-2 text-sm font-extrabold text-ink">
              Service <span class="sr-only">required</span>
              <span class="relative">
                <Icon name="Layers" class="pointer-events-none absolute left-4 top-1/2 h-4 w-4 -translate-y-1/2 text-brass" />
                <select id="service" name="service" required class="w-full appearance-none rounded-2xl border border-ink/10 bg-paper px-11 py-3.5 text-sm text-ink transition hover:border-brass/45 focus:border-brass focus:bg-white aria-[invalid=true]:border-clay">
                  <option value="">Choose service</option>
                  {serviceOptions.map((service) => <option>{service}</option>)}
                </select>
                <Icon name="ChevronDown" class="pointer-events-none absolute right-4 top-1/2 h-4 w-4 -translate-y-1/2 text-graphite/60" />
              </span>
            </label>

            <label for="message" class="grid gap-2 text-sm font-extrabold text-ink sm:col-span-2">
              Message <span class="sr-only">required</span>
              <span class="relative">
                <Icon name="MessageSquare" class="pointer-events-none absolute left-4 top-4 h-4 w-4 text-brass" />
                <textarea id="message" name="message" required rows="7" class="min-h-40 w-full resize-y rounded-2xl border border-ink/10 bg-paper px-11 py-3.5 text-sm leading-7 text-ink transition hover:border-brass/45 focus:border-brass focus:bg-white aria-[invalid=true]:border-clay" placeholder="Tell us your floor type, approximate area, current condition, preferred service, location, timing, and whether you can share photos."></textarea>
              </span>
            </label>
          </div>

          <button class="btn-brass mt-6 w-full py-4" type="submit">Get a Free Quote <Icon name="ArrowRight" class="h-4 w-4" /></button>
          <p data-success hidden class="mt-4 rounded-2xl border border-brass/20 bg-linen p-4 text-sm font-extrabold text-ink">Thanks. Your enquiry has been captured and is ready for backend integration.</p>
        </form>

        <aside class="grid gap-4">
          {contactCards.map((item, index) => (
            <article class="reveal rounded-[1.5rem] border border-ink/10 bg-white p-5 shadow-soft transition duration-300 hover:-translate-y-1 hover:border-brass/45 hover:shadow-lift" style={`transition-delay:${index * 70}ms`}>
              <div class="flex gap-4">
                <span class="grid h-12 w-12 shrink-0 place-items-center rounded-2xl bg-linen text-brass">
                  <Icon name={item.icon} class="h-5 w-5" />
                </span>
                <div class="min-w-0">
                  <h2 class="font-display text-lg font-extrabold text-ink">{item.title}</h2>
                  {item.href ? (
                    <a href={item.href} class="mt-1 block break-words text-sm font-extrabold text-graphite transition hover:text-brass">{item.value}</a>
                  ) : (
                    <p class="mt-1 break-words text-sm font-extrabold text-graphite">{item.value}</p>
                  )}
                  <p class="mt-2 text-sm leading-6 text-graphite/70">{item.note}</p>
                </div>
              </div>
            </article>
          ))}
        </aside>
      </div>
    </div>
  </section>

  <section class="pb-16 sm:pb-20 lg:pb-24">
    <div class="container-shell">
      <div class="reveal overflow-hidden rounded-[2rem] border border-ink/10 bg-ink p-6 text-white shadow-lift sm:p-8 lg:p-10">
        <div class="grid gap-8 lg:grid-cols-[0.85fr_1.15fr] lg:items-center">
          <div>
            <span class="eyebrow border-white/15 bg-white/10 text-brass">Professional Flooring Support</span>
            <h2 class="mt-4 font-display text-3xl font-extrabold leading-tight sm:text-4xl">A clearer quote starts with the right details.</h2>
          </div>
          <div class="grid gap-3 sm:grid-cols-3">
            {trustItems.map(([title, text]) => (
              <article class="rounded-2xl border border-white/10 bg-white/8 p-4 transition duration-300 hover:-translate-y-1 hover:border-brass/45 hover:bg-white/12">
                <Icon name="CheckCircle2" class="h-5 w-5 text-brass" />
                <h3 class="mt-3 font-display text-base font-extrabold text-white">{title}</h3>
                <p class="mt-2 text-sm leading-6 text-white/70">{text}</p>
              </article>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
