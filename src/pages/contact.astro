---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/Icon.astro';
import { services } from '@/data/services.js';
import { contact } from '@/data/contact.js';
---

<BaseLayout title="Contact Pro Handyman SG | Handyman Services Singapore" description="Contact Pro Handyman SG for handyman service enquiries and quote requests across Singapore." canonical="https://prohandymansg.com/contact">
  <section class="bg-linen pt-32">
    <div class="container-shell grid gap-10 pb-16 lg:grid-cols-[0.85fr_1fr]">
      <div>
        <span class="eyebrow">Contact</span>
        <h1 class="mt-5 font-display text-5xl font-extrabold leading-tight sm:text-6xl">Tell us what needs fixing.</h1>
        <p class="mt-5 text-lg leading-8 text-graphite/80">Use this form for general enquiries, or reach us directly by call, WhatsApp, or email for quote details across Singapore.</p>
        <div class="mt-8 grid gap-3">
          <a href={contact.phoneHref} class="flex items-center gap-3 rounded-2xl bg-white p-4 font-bold shadow-soft transition hover:-translate-y-0.5 hover:bg-linen">
            <Icon name="Phone" class="h-5 w-5 text-brass" />
            <span>{contact.phone}</span>
          </a>
          <a href={contact.whatsappHref} class="flex items-center gap-3 rounded-2xl bg-white p-4 font-bold shadow-soft transition hover:-translate-y-0.5 hover:bg-linen">
            <Icon name="MessageSquare" class="h-5 w-5 text-brass" />
            <span>WhatsApp {contact.phone}</span>
          </a>
          <a href={contact.emailHref} class="flex items-center gap-3 rounded-2xl bg-white p-4 font-bold shadow-soft transition hover:-translate-y-0.5 hover:bg-linen">
            <Icon name="Mail" class="h-5 w-5 text-brass" />
            <span>{contact.email}</span>
          </a>
        </div>
        <div class="mt-8 grid gap-3">
          {['Service type', 'Property type', 'Singapore location', 'Preferred timing'].map((item) => (
            <div class="flex items-center gap-3 rounded-2xl bg-white p-4 shadow-soft">
              <Icon name="CheckCircle2" class="h-5 w-5 text-brass" />
              <span class="font-bold">{item}</span>
            </div>
          ))}
        </div>
      </div>
      <form data-enhanced-form class="rounded-[2rem] border border-ink/10 bg-white p-6 shadow-lift sm:p-8">
        <div class="grid gap-4 sm:grid-cols-2">
          <label class="grid gap-2 text-sm font-bold">Name <input required class="rounded-2xl border border-ink/10 px-4 py-3" /></label>
          <label class="grid gap-2 text-sm font-bold">Email <input required type="email" class="rounded-2xl border border-ink/10 px-4 py-3" placeholder={contact.email} /></label>
          <label class="grid gap-2 text-sm font-bold">Phone <input required type="tel" class="rounded-2xl border border-ink/10 px-4 py-3" placeholder={contact.phone} /></label>
          <label class="grid gap-2 text-sm font-bold">Service <select required class="rounded-2xl border border-ink/10 px-4 py-3"><option value="">Choose service</option>{services.map((service) => <option>{service.name}</option>)}</select></label>
          <label class="grid gap-2 text-sm font-bold sm:col-span-2">Message <textarea required rows="6" class="rounded-2xl border border-ink/10 px-4 py-3"></textarea></label>
        </div>
        <button class="btn-brass mt-6 w-full" type="submit">Send Enquiry</button>
        <p data-success hidden class="mt-4 rounded-2xl bg-linen p-4 text-sm font-bold text-ink">Thanks. This demo form is ready for backend integration.</p>
      </form>
    </div>
  </section>
</BaseLayout>
